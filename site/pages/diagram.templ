package pages

import (
	"github.com/pietjan/loom/avatar"
	"github.com/pietjan/loom/diagram"
	"github.com/pietjan/loom/icon"
)

const diagramRequestSnippet = `@diagram.New(
	diagram.Dir(diagram.LeftRight),
	diagram.Edge("net", "lb"),
	diagram.Edge("lb", "web1"),
	diagram.Edge("lb", "web2"),
	diagram.Edge("web1", "cache"),
	diagram.Edge("web2", "cache"),
	diagram.Edge("cache", "db", diagram.Dotted()), // read through on a miss
) {
	@diagram.Node("net", diagram.Stadium()) { Internet }
	@diagram.Node("lb", diagram.WithTone(diagram.ToneAccent)) { Load balancer }
	@diagram.Node("web1") { web-1 }
	@diagram.Node("web2") { web-2 }
	@diagram.Node("cache", diagram.WithTone(diagram.ToneAmber)) { Redis }
	@diagram.Node("db", diagram.WithTone(diagram.ToneEmerald)) { Postgres }
}`

const diagramSchemaSnippet = `// A node body is any markup — here each table is a small card, so the
// nodes use diagram.Bare() to skip the default box chrome.
@diagram.New(
	diagram.Edge("users", "orders", diagram.Label("1:N"), diagram.NoArrow()),
	diagram.Edge("products", "orders", diagram.Label("1:N"), diagram.NoArrow()),
) {
	@diagram.Node("users", diagram.Bare()) {
		@schemaTable("users", "id", "email", "created_at")
	}
	@diagram.Node("products", diagram.Bare()) {
		@schemaTable("products", "id", "name", "price_cents")
	}
	@diagram.Node("orders", diagram.Bare()) {
		@schemaTable("orders", "id", "user_id", "product_id", "qty")
	}
}`

const diagramWorkflowSnippet = `@diagram.New(
	// PortsSpread gives every edge its own attachment point on a node.
	diagram.Ports(diagram.PortsSpread),
	diagram.Edge("draft", "review"),
	diagram.Edge("review", "check"),
	diagram.Edge("check", "publish", diagram.Label("approved")),
	diagram.Edge("check", "revise", diagram.Label("changes")),
	diagram.Edge("revise", "review", diagram.Dashed()),
) {
	@diagram.Node("draft", diagram.Stadium()) { Draft }
	@diagram.Node("review") { In review }
	@diagram.Node("check", diagram.Diamond(), diagram.WithTone(diagram.ToneAccent)) { Approved? }
	@diagram.Node("publish", diagram.WithTone(diagram.ToneEmerald)) { Published }
	@diagram.Node("revise", diagram.WithTone(diagram.ToneAmber)) { Revising }
}`

const diagramStateSnippet = `// A cycle lays out fine, and diagram.BiDirectional() draws an arrowhead on
// both ends — here the two-way transition between Playing and Paused.
@diagram.New(
	diagram.Edge("stop", "play", diagram.Label("play")),
	diagram.Edge("play", "pause", diagram.Label("pause"), diagram.BiDirectional()),
	diagram.Edge("play", "stop", diagram.Label("stop")),
	diagram.Edge("pause", "stop", diagram.Label("stop")),
) {
	@diagram.Node("stop", diagram.Stadium(), diagram.WithTone(diagram.ToneRose)) { Stopped }
	@diagram.Node("play", diagram.Stadium(), diagram.WithTone(diagram.ToneEmerald)) { Playing }
	@diagram.Node("pause", diagram.Stadium(), diagram.WithTone(diagram.ToneAmber)) { Paused }
}`

const diagramOrgSnippet = `// Each parent settles over the midpoint of its children, and diagram.Size
// reserves room for the avatar body the text measurer can't see.
@diagram.New(
	diagram.Edge("ceo", "cto"),
	diagram.Edge("ceo", "cfo"),
	diagram.Edge("cto", "eng1"),
	diagram.Edge("cto", "eng2"),
) {
	@diagram.Node("ceo", diagram.Size(180, 48)) {
		@orgNode("Ada Lovelace", "CEO", "AL")
	}
	@diagram.Node("cto", diagram.Size(180, 48)) {
		@orgNode("Alan Turing", "CTO", "AT")
	}
	// ... cfo, eng1, eng2
}`

const diagramArrowSnippet = `// The arrowhead shape is per-edge: a filled triangle by default, or hollow,
// open, diamond, or dot — here reading like a UML relationship diagram.
@diagram.New(
	diagram.Edge("circle", "shape", diagram.HollowArrow()),
	diagram.Edge("square", "shape", diagram.HollowArrow()),
	diagram.Edge("shape", "canvas", diagram.DiamondArrow(), diagram.Label("drawn on")),
	diagram.Edge("canvas", "render", diagram.OpenArrow(), diagram.Label("calls")),
	diagram.Edge("render", "gpu", diagram.DotArrow(), diagram.Label("submits")),
) {
	@diagram.Node("circle") { Circle }
	@diagram.Node("square") { Square }
	@diagram.Node("shape", diagram.WithTone(diagram.ToneAccent)) { Shape }
	@diagram.Node("canvas", diagram.WithTone(diagram.ToneIndigo)) { Canvas }
	@diagram.Node("render") { Renderer }
	@diagram.Node("gpu", diagram.WithTone(diagram.ToneEmerald)) { GPU }
}`

// schemaTable renders a schema-style table card used as a diagram node body.
templ schemaTable(name string, columns ...string) {
	<div class="w-full overflow-hidden rounded-lg border border-base-200 bg-white text-left dark:border-base-600 dark:bg-base-800">
		<div class="flex items-center gap-1.5 border-b border-base-200 bg-base-50 px-2.5 py-1 text-[12px] font-semibold text-base-700 dark:border-base-600 dark:bg-base-700/50 dark:text-base-100">
			@icon.New(icon.Table, icon.Small)
			{ name }
		</div>
		<ul class="px-2.5 py-1 font-mono text-[11px] text-base-500 dark:text-base-400">
			for _, c := range columns {
				<li>{ c }</li>
			}
		</ul>
	</div>
}

// iconNode renders an icon-and-label node body.
templ iconNode(name string, glyph icon.Name) {
	<span class="inline-flex items-center gap-1.5">
		@icon.New(glyph, icon.Small)
		{ name }
	</span>
}

// orgNode renders an avatar-and-title node body for the org chart.
templ orgNode(name, role, initials string) {
	<span class="flex items-center gap-2">
		@avatar.New(avatar.Initials(initials), avatar.Small)
		<span class="text-left leading-tight">
			<span class="block text-xs font-semibold text-base-700 dark:text-base-100">{ name }</span>
			<span class="block text-[11px] text-base-500 dark:text-base-400">{ role }</span>
		</span>
	</span>
}

templ Diagram() {
	@componentPage("diagram") {
		@prose() {
			Diagrams render server-side as SVG. Declare nodes as children — each body is
			any templ component — and wire them with edges; the component breaks cycles,
			assigns layers, and places everything automatically, no JavaScript.
		}
		@example("Request path", diagramRequestSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Dir(diagram.LeftRight),
					diagram.Edge("net", "lb"),
					diagram.Edge("lb", "web1"),
					diagram.Edge("lb", "web2"),
					diagram.Edge("web1", "cache"),
					diagram.Edge("web2", "cache"),
					diagram.Edge("cache", "db", diagram.Dotted()),
				) {
					@diagram.Node("net", diagram.Stadium()) {
						@iconNode("Internet", icon.Globe)
					}
					@diagram.Node("lb", diagram.WithTone(diagram.ToneAccent)) {
						@iconNode("Load balancer", icon.ArrowsSplit)
					}
					@diagram.Node("web1") {
						@iconNode("web-1", icon.Browsers)
					}
					@diagram.Node("web2") {
						@iconNode("web-2", icon.Browsers)
					}
					@diagram.Node("cache", diagram.WithTone(diagram.ToneAmber)) {
						@iconNode("Redis", icon.Lightning)
					}
					@diagram.Node("db", diagram.WithTone(diagram.ToneEmerald)) {
						@iconNode("Postgres", icon.Database)
					}
				}
			</div>
		}
		@example("Database schema", diagramSchemaSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Edge("users", "orders", diagram.Label("1:N"), diagram.NoArrow()),
					diagram.Edge("products", "orders", diagram.Label("1:N"), diagram.NoArrow()),
				) {
					@diagram.Node("users", diagram.Bare()) {
						@schemaTable("users", "id", "email", "created_at")
					}
					@diagram.Node("products", diagram.Bare()) {
						@schemaTable("products", "id", "name", "price_cents")
					}
					@diagram.Node("orders", diagram.Bare()) {
						@schemaTable("orders", "id", "user_id", "product_id", "qty")
					}
				}
			</div>
		}
		@example("Approval workflow", diagramWorkflowSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Ports(diagram.PortsSpread),
					diagram.Edge("draft", "review"),
					diagram.Edge("review", "check"),
					diagram.Edge("check", "publish", diagram.Label("approved")),
					diagram.Edge("check", "revise", diagram.Label("changes")),
					diagram.Edge("revise", "review", diagram.Dashed()),
				) {
					@diagram.Node("draft", diagram.Stadium()) {
						Draft
					}
					@diagram.Node("review") {
						In review
					}
					@diagram.Node("check", diagram.Diamond(), diagram.WithTone(diagram.ToneAccent)) {
						Approved?
					}
					@diagram.Node("publish", diagram.WithTone(diagram.ToneEmerald)) {
						Published
					}
					@diagram.Node("revise", diagram.WithTone(diagram.ToneAmber)) {
						Revising
					}
				}
			</div>
		}
		@example("State machine", diagramStateSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Edge("stop", "play", diagram.Label("play")),
					diagram.Edge("play", "pause", diagram.Label("pause"), diagram.BiDirectional()),
					diagram.Edge("play", "stop", diagram.Label("stop")),
					diagram.Edge("pause", "stop", diagram.Label("stop")),
				) {
					@diagram.Node("stop", diagram.Stadium(), diagram.WithTone(diagram.ToneRose)) {
						@iconNode("Stopped", icon.Stop)
					}
					@diagram.Node("play", diagram.Stadium(), diagram.WithTone(diagram.ToneEmerald)) {
						@iconNode("Playing", icon.Play)
					}
					@diagram.Node("pause", diagram.Stadium(), diagram.WithTone(diagram.ToneAmber)) {
						@iconNode("Paused", icon.Pause)
					}
				}
			</div>
		}
		@example("Arrowhead styles", diagramArrowSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Edge("circle", "shape", diagram.HollowArrow()),
					diagram.Edge("square", "shape", diagram.HollowArrow()),
					diagram.Edge("shape", "canvas", diagram.DiamondArrow(), diagram.Label("drawn on")),
					diagram.Edge("canvas", "render", diagram.OpenArrow(), diagram.Label("calls")),
					diagram.Edge("render", "gpu", diagram.DotArrow(), diagram.Label("submits")),
				) {
					@diagram.Node("circle") {
						Circle
					}
					@diagram.Node("square") {
						Square
					}
					@diagram.Node("shape", diagram.WithTone(diagram.ToneAccent)) {
						Shape
					}
					@diagram.Node("canvas", diagram.WithTone(diagram.ToneIndigo)) {
						Canvas
					}
					@diagram.Node("render") {
						Renderer
					}
					@diagram.Node("gpu", diagram.WithTone(diagram.ToneEmerald)) {
						GPU
					}
				}
			</div>
		}
		@example("Org chart", diagramOrgSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Edge("ceo", "cto"),
					diagram.Edge("ceo", "cfo"),
					diagram.Edge("cto", "eng1"),
					diagram.Edge("cto", "eng2"),
				) {
					@diagram.Node("ceo", diagram.Size(180, 48)) {
						@orgNode("Ada Lovelace", "CEO", "AL")
					}
					@diagram.Node("cto", diagram.Size(180, 48)) {
						@orgNode("Alan Turing", "CTO", "AT")
					}
					@diagram.Node("cfo", diagram.Size(180, 48)) {
						@orgNode("Grace Hopper", "CFO", "GH")
					}
					@diagram.Node("eng1", diagram.Size(180, 48)) {
						@orgNode("Linus Torvalds", "Engineer", "LT")
					}
					@diagram.Node("eng2", diagram.Size(180, 48)) {
						@orgNode("Rob Pike", "Engineer", "RP")
					}
				}
			</div>
		}
	}
}
