package pages

import (
	"github.com/pietjan/loom/avatar"
	"github.com/pietjan/loom/diagram"
	"github.com/pietjan/loom/icon"
)

const diagramRequestSnippet = `@diagram.New(
	diagram.Dir(diagram.LeftRight),
	diagram.Edge("net", "lb"),
	diagram.Edge("lb", "web1"),
	diagram.Edge("lb", "web2"),
	diagram.Edge("web1", "cache"),
	diagram.Edge("web2", "cache"),
	diagram.Edge("cache", "db", diagram.Dotted()), // read through on a miss
) {
	@diagram.Node("net", diagram.Stadium()) { Internet }
	@diagram.Node("lb", diagram.Accent) { Load balancer }
	@diagram.Node("web1") { web-1 }
	@diagram.Node("web2") { web-2 }
	@diagram.Node("cache", diagram.Amber) { Redis }
	@diagram.Node("db", diagram.Emerald) { Postgres }
}`

const diagramProvenanceSnippet = `// BottomTop reflects the drawing on the flow axis, so the edges still run
// from a dependency to what consumes it - only the layers stack upward.
@diagram.New(
	diagram.Dir(diagram.BottomTop),
	diagram.Edge("src", "compile"),
	diagram.Edge("vendor", "compile"),
	diagram.Edge("compile", "binary"),
	diagram.Edge("binary", "image", diagram.Label("packaged into")),
) {
	@diagram.Node("src", diagram.Stadium()) { Source }
	@diagram.Node("vendor", diagram.Stadium()) { Vendored deps }
	@diagram.Node("compile", diagram.Accent) { go build }
	@diagram.Node("binary", diagram.Amber) { Binary }
	@diagram.Node("image", diagram.Emerald) { Image }
}`

const diagramSchemaSnippet = `// A node body is any markup - here each table is a small card, so the
// nodes use diagram.Bare() to skip the default box chrome. Each arrow runs
// from the table holding the key to the one it points at; users and teams
// reference each other, and the cycle lays out without special handling.
@diagram.New(
	diagram.Edge("users", "teams", diagram.Label("team_id")),
	diagram.Edge("teams", "users", diagram.Label("owner_id")),
	diagram.Edge("orders", "users", diagram.Label("user_id")),
	diagram.Edge("items", "orders", diagram.Label("order_id")),
	diagram.Edge("items", "products", diagram.Label("product_id")),
	diagram.Edge("products", "categories", diagram.Label("category_id")),
) {
	@diagram.Node("users", diagram.Bare()) {
		@schemaTable("users", "id", "email", "team_id")
	}
	@diagram.Node("teams", diagram.Bare()) {
		@schemaTable("teams", "id", "name", "owner_id")
	}
	// ... categories, products, orders, items
}`

const diagramTopologySnippet = `// Physical links have no direction, so every edge uses diagram.NoArrow().
// The standby uplink is dashed, and the pair of edge routers puts a
// diamond in front of the firewall.
@diagram.New(
	diagram.Edge("net", "edge1", diagram.NoArrow()),
	diagram.Edge("net", "edge2", diagram.NoArrow(), diagram.Dashed()),
	diagram.Edge("edge1", "fw", diagram.NoArrow()),
	diagram.Edge("edge2", "fw", diagram.NoArrow()),
	diagram.Edge("fw", "core", diagram.NoArrow(), diagram.Label("10G")),
	diagram.Edge("core", "sw1", diagram.NoArrow()),
	diagram.Edge("core", "sw2", diagram.NoArrow()),
	diagram.Edge("sw1", "app1", diagram.NoArrow()),
	// ... app2, nas on sw1; desk, laptop, printer on sw2
) {
	@diagram.Node("net", diagram.Stadium()) { @iconNode("Internet", icon.Globe) }
	@diagram.Node("edge1", diagram.Accent) {
		@iconNode("edge-1", icon.ArrowsSplit)
	}
	@diagram.Node("fw", diagram.Rose) {
		@iconNode("firewall", icon.ShieldCheck)
	}
	@diagram.Node("core", diagram.Indigo) {
		@iconNode("core-sw", icon.SquaresFour)
	}
	// ... switches and machines
}`

const diagramWorkflowSnippet = `@diagram.New(
	// PortsSpread gives every edge its own attachment point on a node.
	diagram.Ports(diagram.PortsSpread),
	diagram.Edge("draft", "review"),
	diagram.Edge("review", "check"),
	diagram.Edge("check", "publish", diagram.Label("approved")),
	diagram.Edge("check", "revise", diagram.Label("changes")),
	diagram.Edge("revise", "review", diagram.Dashed()),
) {
	@diagram.Node("draft", diagram.Stadium()) { Draft }
	@diagram.Node("review") { In review }
	@diagram.Node("check", diagram.Diamond(), diagram.Accent) { Approved? }
	@diagram.Node("publish", diagram.Emerald) { Published }
	@diagram.Node("revise", diagram.Amber) { Revising }
}`

const diagramFanSnippet = `// A wide fan is where spread ports earn their keep. The gap between two
// layers is a routing channel: its sideways runs are ordered so none cuts
// across another, and each edge keeps its own line from port to arrowhead
// instead of the whole fan merging into one bar. The gap widens to fit.
@diagram.New(
	diagram.Ports(diagram.PortsSpread),
	diagram.Edge("event", "email"),
	diagram.Edge("event", "sms"),
	diagram.Edge("event", "push"),
	diagram.Edge("event", "hook"),
	diagram.Edge("event", "audit"),
	diagram.Edge("event", "metrics"),
) {
	@diagram.Node("event", diagram.Stadium(), diagram.Accent) { Event }
	@diagram.Node("email") { Email }
	@diagram.Node("sms") { SMS }
	// ... push, hook, audit, metrics
}`

const diagramStateSnippet = `// A cycle lays out fine, and diagram.BiDirectional() draws an arrowhead on
// both ends - here the two-way transition between Playing and Paused.
@diagram.New(
	diagram.Edge("stop", "play", diagram.Label("play")),
	diagram.Edge("play", "pause", diagram.Label("pause"), diagram.BiDirectional()),
	diagram.Edge("play", "stop", diagram.Label("stop")),
	diagram.Edge("pause", "stop", diagram.Label("stop")),
) {
	@diagram.Node("stop", diagram.Stadium(), diagram.Rose) { Stopped }
	@diagram.Node("play", diagram.Stadium(), diagram.Emerald) { Playing }
	@diagram.Node("pause", diagram.Stadium(), diagram.Amber) { Paused }
}`

const diagramOrgSnippet = `// Each parent settles over the midpoint of its children, and diagram.Size
// reserves room for the avatar body the text measurer can't see.
@diagram.New(
	diagram.Edge("ceo", "cto"),
	diagram.Edge("ceo", "cfo"),
	diagram.Edge("cto", "eng1"),
	diagram.Edge("cto", "eng2"),
) {
	@diagram.Node("ceo", diagram.Size(180, 48)) {
		@orgNode("Ada Lovelace", "CEO", "AL")
	}
	@diagram.Node("cto", diagram.Size(180, 48)) {
		@orgNode("Alan Turing", "CTO", "AT")
	}
	// ... cfo, eng1, eng2
}`

const diagramArrowSnippet = `// The arrowhead shape is per-edge: a filled triangle by default, or hollow,
// open, diamond, or dot - here reading like a UML relationship diagram.
@diagram.New(
	diagram.Edge("circle", "shape", diagram.HollowArrow()),
	diagram.Edge("square", "shape", diagram.HollowArrow()),
	diagram.Edge("shape", "canvas", diagram.DiamondArrow(), diagram.Label("drawn on")),
	diagram.Edge("canvas", "render", diagram.OpenArrow(), diagram.Label("calls")),
	diagram.Edge("render", "gpu", diagram.DotArrow(), diagram.Label("submits")),
) {
	@diagram.Node("circle") { Circle }
	@diagram.Node("square") { Square }
	@diagram.Node("shape", diagram.Accent) { Shape }
	@diagram.Node("canvas", diagram.Indigo) { Canvas }
	@diagram.Node("render") { Renderer }
	@diagram.Node("gpu", diagram.Emerald) { GPU }
}`

const diagramOrderSnippet = `// Layout follows the edges, not the order the nodes are written in. Both of
// these declare the same graph - retry cycle and all - with the node blocks
// in opposite orders, and both lay out identically.
edges := []diagram.Option{
	diagram.Edge("ingest", "queue"),
	diagram.Edge("queue", "worker"),
	diagram.Edge("worker", "queue", diagram.Dashed(), diagram.Label("retry")),
	diagram.Edge("worker", "store"),
	diagram.Edge("ingest", "audit"),
	diagram.Edge("store", "audit"),
}

@diagram.New(edges...) {
	@diagram.Node("ingest", diagram.Stadium()) { ingest }
	@diagram.Node("queue") { queue }
	@diagram.Node("worker", diagram.Accent) { worker }
	@diagram.Node("store", diagram.Emerald) { store }
	@diagram.Node("audit", diagram.Amber) { audit }
}

@diagram.New(edges...) { // same edges, declarations reversed
	@diagram.Node("audit", diagram.Amber) { audit }
	@diagram.Node("store", diagram.Emerald) { store }
	@diagram.Node("worker", diagram.Accent) { worker }
	@diagram.Node("queue") { queue }
	@diagram.Node("ingest", diagram.Stadium()) { ingest }
}`

// orderDemoEdges is the graph both halves of the declaration-order example
// draw. It has a cycle on purpose: breaking one is where the order used to
// change the shape of the drawing.
func orderDemoEdges() []diagram.Option {
	return []diagram.Option{
		diagram.Edge("ingest", "queue"),
		diagram.Edge("queue", "worker"),
		diagram.Edge("worker", "queue", diagram.Dashed(), diagram.Label("retry")),
		diagram.Edge("worker", "store"),
		diagram.Edge("ingest", "audit"),
		diagram.Edge("store", "audit"),
	}
}

// schemaTable renders a schema-style table card used as a diagram node body.
templ schemaTable(name string, columns ...string) {
	<div class="w-full overflow-hidden rounded-lg border border-base-200 bg-white text-left dark:border-base-600 dark:bg-base-800">
		<div class="flex items-center gap-1.5 border-b border-base-200 bg-base-50 px-2.5 py-1 text-[12px] font-semibold text-base-700 dark:border-base-600 dark:bg-base-700/50 dark:text-base-100">
			@icon.New(icon.Table, icon.Small)
			{ name }
		</div>
		<ul class="px-2.5 py-1 font-mono text-[11px] text-base-500 dark:text-base-400">
			for _, c := range columns {
				<li>{ c }</li>
			}
		</ul>
	</div>
}

// iconNode renders an icon-and-label node body.
templ iconNode(name string, glyph icon.Name) {
	<span class="inline-flex items-center gap-1.5">
		@icon.New(glyph, icon.Small)
		{ name }
	</span>
}

// orgNode renders an avatar-and-title node body for the org chart.
templ orgNode(name, role, initials string) {
	<span class="flex items-center gap-2">
		@avatar.New(avatar.Initials(initials), avatar.Small)
		<span class="text-left leading-tight">
			<span class="block text-xs font-semibold text-base-700 dark:text-base-100">{ name }</span>
			<span class="block text-[11px] text-base-500 dark:text-base-400">{ role }</span>
		</span>
	</span>
}

templ Diagram() {
	@componentPage("diagram") {
		@prose() {
			Diagrams render server-side as SVG. Declare nodes as children - each body is
			any templ component - and wire them with edges; the component breaks cycles,
			assigns layers, and places everything automatically.
		}
		@example("Request path", diagramRequestSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Dir(diagram.LeftRight),
					diagram.Edge("net", "lb"),
					diagram.Edge("lb", "web1"),
					diagram.Edge("lb", "web2"),
					diagram.Edge("web1", "cache"),
					diagram.Edge("web2", "cache"),
					diagram.Edge("cache", "db", diagram.Dotted()),
				) {
					@diagram.Node("net", diagram.Stadium()) {
						@iconNode("Internet", icon.Globe)
					}
					@diagram.Node("lb", diagram.Accent) {
						@iconNode("Load balancer", icon.ArrowsSplit)
					}
					@diagram.Node("web1") {
						@iconNode("web-1", icon.Browsers)
					}
					@diagram.Node("web2") {
						@iconNode("web-2", icon.Browsers)
					}
					@diagram.Node("cache", diagram.Amber) {
						@iconNode("Redis", icon.Lightning)
					}
					@diagram.Node("db", diagram.Emerald) {
						@iconNode("Postgres", icon.Database)
					}
				}
			</div>
		}
		@example("Build provenance", diagramProvenanceSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Dir(diagram.BottomTop),
					diagram.Edge("src", "compile"),
					diagram.Edge("vendor", "compile"),
					diagram.Edge("compile", "binary"),
					diagram.Edge("binary", "image", diagram.Label("packaged into")),
				) {
					@diagram.Node("src", diagram.Stadium()) {
						@iconNode("Source", icon.FileCode)
					}
					@diagram.Node("vendor", diagram.Stadium()) {
						@iconNode("Vendored deps", icon.Package)
					}
					@diagram.Node("compile", diagram.Accent) {
						@iconNode("go build", icon.Wrench)
					}
					@diagram.Node("binary", diagram.Amber) {
						@iconNode("Binary", icon.Code)
					}
					@diagram.Node("image", diagram.Emerald) {
						@iconNode("Image", icon.Cube)
					}
				}
			</div>
		}
		@example("Network topology", diagramTopologySnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Edge("net", "edge1", diagram.NoArrow()),
					diagram.Edge("net", "edge2", diagram.NoArrow(), diagram.Dashed()),
					diagram.Edge("edge1", "fw", diagram.NoArrow()),
					diagram.Edge("edge2", "fw", diagram.NoArrow()),
					diagram.Edge("fw", "core", diagram.NoArrow(), diagram.Label("10G")),
					diagram.Edge("core", "sw1", diagram.NoArrow()),
					diagram.Edge("core", "sw2", diagram.NoArrow()),
					diagram.Edge("sw1", "app1", diagram.NoArrow()),
					diagram.Edge("sw1", "app2", diagram.NoArrow()),
					diagram.Edge("sw1", "nas", diagram.NoArrow()),
					diagram.Edge("sw2", "desk", diagram.NoArrow()),
					diagram.Edge("sw2", "laptop", diagram.NoArrow()),
					diagram.Edge("sw2", "printer", diagram.NoArrow()),
				) {
					@diagram.Node("net", diagram.Stadium()) {
						@iconNode("Internet", icon.Globe)
					}
					@diagram.Node("edge1", diagram.Accent) {
						@iconNode("edge-1", icon.ArrowsSplit)
					}
					@diagram.Node("edge2", diagram.Accent) {
						@iconNode("edge-2", icon.ArrowsSplit)
					}
					@diagram.Node("fw", diagram.Rose) {
						@iconNode("firewall", icon.ShieldCheck)
					}
					@diagram.Node("core", diagram.Indigo) {
						@iconNode("core-sw", icon.SquaresFour)
					}
					@diagram.Node("sw1", diagram.Indigo) {
						@iconNode("rack-sw", icon.SquaresFour)
					}
					@diagram.Node("sw2", diagram.Indigo) {
						@iconNode("floor-sw", icon.SquaresFour)
					}
					@diagram.Node("app1", diagram.Emerald) {
						@iconNode("app-01", icon.HardDrives)
					}
					@diagram.Node("app2", diagram.Emerald) {
						@iconNode("app-02", icon.HardDrives)
					}
					@diagram.Node("nas", diagram.Emerald) {
						@iconNode("nas-01", icon.Database)
					}
					@diagram.Node("desk", diagram.Amber) {
						@iconNode("desk-01", icon.Desktop)
					}
					@diagram.Node("laptop", diagram.Amber) {
						@iconNode("laptop-02", icon.Laptop)
					}
					@diagram.Node("printer", diagram.Amber) {
						@iconNode("printer-01", icon.Printer)
					}
				}
			</div>
		}
		@example("Database schema", diagramSchemaSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Edge("users", "teams", diagram.Label("team_id")),
					diagram.Edge("teams", "users", diagram.Label("owner_id")),
					diagram.Edge("orders", "users", diagram.Label("user_id")),
					diagram.Edge("items", "orders", diagram.Label("order_id")),
					diagram.Edge("items", "products", diagram.Label("product_id")),
					diagram.Edge("products", "categories", diagram.Label("category_id")),
				) {
					@diagram.Node("users", diagram.Bare()) {
						@schemaTable("users", "id", "email", "team_id")
					}
					@diagram.Node("teams", diagram.Bare()) {
						@schemaTable("teams", "id", "name", "owner_id")
					}
					@diagram.Node("categories", diagram.Bare()) {
						@schemaTable("categories", "id", "name")
					}
					@diagram.Node("products", diagram.Bare()) {
						@schemaTable("products", "id", "name", "category_id")
					}
					@diagram.Node("orders", diagram.Bare()) {
						@schemaTable("orders", "id", "user_id", "placed_at")
					}
					@diagram.Node("items", diagram.Bare()) {
						@schemaTable("order_items", "id", "order_id", "product_id", "qty")
					}
				}
			</div>
		}
		@example("Approval workflow", diagramWorkflowSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Ports(diagram.PortsSpread),
					diagram.Edge("draft", "review"),
					diagram.Edge("review", "check"),
					diagram.Edge("check", "publish", diagram.Label("approved")),
					diagram.Edge("check", "revise", diagram.Label("changes")),
					diagram.Edge("revise", "review", diagram.Dashed()),
				) {
					@diagram.Node("draft", diagram.Stadium()) {
						Draft
					}
					@diagram.Node("review") {
						In review
					}
					@diagram.Node("check", diagram.Diamond(), diagram.Accent) {
						Approved?
					}
					@diagram.Node("publish", diagram.Emerald) {
						Published
					}
					@diagram.Node("revise", diagram.Amber) {
						Revising
					}
				}
			</div>
		}
		@example("Fan-out on spread ports", diagramFanSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Ports(diagram.PortsSpread),
					diagram.Edge("event", "email"),
					diagram.Edge("event", "sms"),
					diagram.Edge("event", "push"),
					diagram.Edge("event", "hook"),
					diagram.Edge("event", "audit"),
					diagram.Edge("event", "metrics"),
				) {
					@diagram.Node("event", diagram.Stadium(), diagram.Accent) {
						Event
					}
					@diagram.Node("email") {
						Email
					}
					@diagram.Node("sms") {
						SMS
					}
					@diagram.Node("push") {
						Push
					}
					@diagram.Node("hook") {
						Webhook
					}
					@diagram.Node("audit", diagram.Amber) {
						Audit log
					}
					@diagram.Node("metrics", diagram.Emerald) {
						Metrics
					}
				}
			</div>
		}
		@example("State machine", diagramStateSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Edge("stop", "play", diagram.Label("play")),
					diagram.Edge("play", "pause", diagram.Label("pause"), diagram.BiDirectional()),
					diagram.Edge("play", "stop", diagram.Label("stop")),
					diagram.Edge("pause", "stop", diagram.Label("stop")),
				) {
					@diagram.Node("stop", diagram.Stadium(), diagram.Rose) {
						@iconNode("Stopped", icon.Stop)
					}
					@diagram.Node("play", diagram.Stadium(), diagram.Emerald) {
						@iconNode("Playing", icon.Play)
					}
					@diagram.Node("pause", diagram.Stadium(), diagram.Amber) {
						@iconNode("Paused", icon.Pause)
					}
				}
			</div>
		}
		@example("Arrowhead styles", diagramArrowSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Edge("circle", "shape", diagram.HollowArrow()),
					diagram.Edge("square", "shape", diagram.HollowArrow()),
					diagram.Edge("shape", "canvas", diagram.DiamondArrow(), diagram.Label("drawn on")),
					diagram.Edge("canvas", "render", diagram.OpenArrow(), diagram.Label("calls")),
					diagram.Edge("render", "gpu", diagram.DotArrow(), diagram.Label("submits")),
				) {
					@diagram.Node("circle") {
						Circle
					}
					@diagram.Node("square") {
						Square
					}
					@diagram.Node("shape", diagram.Accent) {
						Shape
					}
					@diagram.Node("canvas", diagram.Indigo) {
						Canvas
					}
					@diagram.Node("render") {
						Renderer
					}
					@diagram.Node("gpu", diagram.Emerald) {
						GPU
					}
				}
			</div>
		}
		@example("Org chart", diagramOrgSnippet) {
			<div class="w-full overflow-x-auto">
				@diagram.New(
					diagram.Edge("ceo", "cto"),
					diagram.Edge("ceo", "cfo"),
					diagram.Edge("cto", "eng1"),
					diagram.Edge("cto", "eng2"),
				) {
					@diagram.Node("ceo", diagram.Size(180, 48)) {
						@orgNode("Ada Lovelace", "CEO", "AL")
					}
					@diagram.Node("cto", diagram.Size(180, 48)) {
						@orgNode("Alan Turing", "CTO", "AT")
					}
					@diagram.Node("cfo", diagram.Size(180, 48)) {
						@orgNode("Grace Hopper", "CFO", "GH")
					}
					@diagram.Node("eng1", diagram.Size(180, 48)) {
						@orgNode("Linus Torvalds", "Engineer", "LT")
					}
					@diagram.Node("eng2", diagram.Size(180, 48)) {
						@orgNode("Rob Pike", "Engineer", "RP")
					}
				}
			</div>
		}
		@example("Declaration order", diagramOrderSnippet) {
			<div class="flex flex-wrap items-start gap-10">
				<div class="space-y-2">
					<p class="text-xs font-medium text-base-500 dark:text-base-400">declared ingest → audit</p>
					@diagram.New(orderDemoEdges()...) {
						@diagram.Node("ingest", diagram.Stadium()) {
							ingest
						}
						@diagram.Node("queue") {
							queue
						}
						@diagram.Node("worker", diagram.Accent) {
							worker
						}
						@diagram.Node("store", diagram.Emerald) {
							store
						}
						@diagram.Node("audit", diagram.Amber) {
							audit
						}
					}
				</div>
				<div class="space-y-2">
					<p class="text-xs font-medium text-base-500 dark:text-base-400">declared audit → ingest</p>
					@diagram.New(orderDemoEdges()...) {
						@diagram.Node("audit", diagram.Amber) {
							audit
						}
						@diagram.Node("store", diagram.Emerald) {
							store
						}
						@diagram.Node("worker", diagram.Accent) {
							worker
						}
						@diagram.Node("queue") {
							queue
						}
						@diagram.Node("ingest", diagram.Stadium()) {
							ingest
						}
					}
				</div>
			</div>
		}
	}
}
