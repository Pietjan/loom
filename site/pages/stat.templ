package pages

import (
	"github.com/pietjan/loom/badge"
	"github.com/pietjan/loom/chart"
	"github.com/pietjan/loom/stat"
)

const statSnippet = `@stat.New(stat.Label("Revenue"), stat.Value("$48.2k")) {
	@badge.New(badge.Green) { +12% }
}`

const statTrendSnippet = `@stat.New(
	stat.Label("Revenue"), stat.Value("$48.2k"), stat.Class("h-34"),
	stat.Background(chart.New(
		chart.Sparkline(), chart.Area(), chart.Smooth(), chart.Inset(0),
		chart.Series("Revenue", []float64{12, 18, 15, 24, 22, 31, 28, 39}),
	)),
) {
	@badge.New(badge.Green) { +12% }
}`

templ Stat() {
	@componentPage("stat") {
		@example("KPI tiles", statSnippet) {
			<div class="grid w-full gap-4 sm:grid-cols-3">
				@stat.New(stat.Label("Revenue"), stat.Value("$48.2k")) {
					@badge.New(badge.Green) {
						+12%
					}
				}
				@stat.New(stat.Label("Signups"), stat.Value("1,204")) {
					@badge.New(badge.Green) {
						+8%
					}
				}
				@stat.New(stat.Label("Churn"), stat.Value("2.1%")) {
					@badge.New(badge.Red) {
						+0.3%
					}
				}
			</div>
		}
		@example("Sparkline background", statTrendSnippet) {
			<div class="grid w-full gap-4 sm:grid-cols-3">
				@stat.New(
					stat.Label("Revenue"), stat.Value("$48.2k"), stat.Class("h-34"),
					stat.Background(chart.New(
						chart.Sparkline(), chart.Area(), chart.Smooth(), chart.Inset(0),
						chart.Series("Revenue", []float64{12, 18, 15, 24, 22, 31, 28, 39}),
					)),
				) {
					@badge.New(badge.Green) {
						+12%
					}
				}
				@stat.New(
					stat.Label("Signups"), stat.Value("1,204"), stat.Class("h-34"),
					stat.Background(chart.New(
						chart.Sparkline(), chart.Area(), chart.Smooth(), chart.Inset(0),
						chart.Series("Signups", []float64{80, 96, 91, 118, 130, 122, 149, 160}, chart.Colored(chart.Emerald)),
					)),
				) {
					@badge.New(badge.Green) {
						+8%
					}
				}
				@stat.New(
					stat.Label("Churn"), stat.Value("2.1%"), stat.Class("h-34"),
					stat.Background(chart.New(
						chart.Sparkline(), chart.Area(), chart.Smooth(), chart.Inset(0),
						chart.Series("Churn", []float64{1.2, 1.4, 1.3, 1.7, 1.6, 1.9, 2.0, 2.1}, chart.Colored(chart.Rose)),
					)),
				) {
					@badge.New(badge.Red) {
						+0.3%
					}
				}
			</div>
		}
	}
}
